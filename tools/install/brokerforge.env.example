# BrokerForge install settings: copy to brokerforge.env, fill in, then run tools/install/install.sh brokerforge.env.
# No secrets go in this file.

# The Dataverse environment BrokerForge serves (Power Platform admin center > the environment > Details).
ORG_URL=https://contoso.crm4.dynamics.com
ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000

# Azure: a new or empty resource group in the subscription az is signed in to. The prefix names its resources.
# Some regions don't take new resources for every subscription (West Europe refused ours): if the install says
# "The selected region is currently not accepting new customers", delete the empty resource group and pick another.
RESOURCE_GROUP=rg-brokerforge
LOCATION=uksouth
PREFIX=brokerforge

# The managed core solution from the GitHub release (BrokerForgeCore_managed.zip).
PACKAGE=BrokerForgeCore_managed.zip

# true adds the sample Orders and Inventory API, to try BrokerForge before connecting a real source.
SAMPLES=false
